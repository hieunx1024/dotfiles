diff --git a/src/main.cpp b/src/main.cpp
index 6853264..e374ad2 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -261,6 +261,52 @@ void onKeyPress(void* thisptr, SCallbackInfo& info, std::any args) {
     const auto keycode = e.keycode + 8; // Because to xkbcommon it's +8 from libinput
     const xkb_keysym_t keysym = xkb_state_key_get_one_sym(k->m_xkbSymState, keycode);
 
+    // Điều hướng bằng phím khi overview đang mở: ←/→ hoặc h/l đổi workspace trên màn có chuột
+    // (xem trước ngay dưới panel), Enter đóng overview trên mọi màn. Chặn cả press lẫn release
+    // của các phím này để app bên dưới không nhận; overview đóng thì phím đi bình thường.
+    bool anyActive = false;
+    for (auto& widget : g_overviewWidgets) {
+        if (widget != nullptr && widget->isActive())
+            anyActive = true;
+    }
+    if (anyActive) {
+        const bool pressed = e.state == WL_KEYBOARD_KEY_STATE_PRESSED;
+        int        dir     = 0;
+        if (keysym == XKB_KEY_Left || keysym == XKB_KEY_h)
+            dir = -1;
+        else if (keysym == XKB_KEY_Right || keysym == XKB_KEY_l)
+            dir = 1;
+
+        if (dir != 0) {
+            info.cancelled = true;
+            if (!pressed)
+                return;
+            const auto pMonitor = g_pCompositor->getMonitorFromCursor();
+            if (!pMonitor)
+                return;
+            std::vector<WORKSPACEID> ids;
+            for (auto& ws : g_pCompositor->getWorkspaces()) {
+                if (ws->m_monitor && ws->m_monitor->m_id == pMonitor->m_id && !ws->m_isSpecialWorkspace && ws->m_id > 0)
+                    ids.push_back(ws->m_id);
+            }
+            if (ids.size() < 2)
+                return;
+            std::ranges::sort(ids);
+            const auto cur = std::ranges::find(ids, pMonitor->activeWorkspaceID());
+            size_t     idx = cur == ids.end() ? 0 : cur - ids.begin();
+            idx            = (idx + ids.size() + dir) % ids.size();
+            pMonitor->changeWorkspace(ids[idx]);
+            return;
+        }
+
+        if (keysym == XKB_KEY_Return || keysym == XKB_KEY_KP_Enter) {
+            info.cancelled = true;
+            if (pressed)
+                hideAllOverviews();
+            return;
+        }
+    }
+
     // Get configured exit key (default to Escape if not configured)
     const auto cfgExitKey = std::any_cast<Hyprlang::STRING>(HyprlandAPI::getConfigValue(pHandle, "plugin:overview:exitKey")->getValue());
     const xkb_keysym_t cfgExitKeysym = xkb_keysym_from_name(cfgExitKey, XKB_KEYSYM_CASE_INSENSITIVE);
