diff --git a/src/main.cpp b/src/main.cpp
index 6853264..43d02ce 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -465,6 +465,15 @@ void registerMonitors() {
 APICALL EXPORT PLUGIN_DESCRIPTION_INFO PLUGIN_INIT(HANDLE inHandle) {
     pHandle = inHandle;
 
+    // Từ chối nạp nếu Hyprland đã đổi bản (apt upgrade) mà plugin chưa build lại:
+    // lệch ABI sẽ crash ngay lúc đăng nhập. Throw ở đây Hyprland bắt được và unload êm.
+    const std::string HASH        = __hyprland_api_get_hash();
+    const std::string CLIENT_HASH = __hyprland_api_get_client_hash();
+    if (HASH != CLIENT_HASH) {
+        HyprlandAPI::addNotification(pHandle, "[Hyprspace] Hyprland đã đổi phiên bản - chạy lại build-hyprspace.sh", CHyprColor{1.0, 0.2, 0.2, 1.0}, 10000);
+        throw std::runtime_error("[Hyprspace] Version mismatch");
+    }
+
     Log::logger->log(Log::DEBUG, "Loading overview plugin");
 
     HyprlandAPI::addConfigValue(pHandle, "plugin:overview:panelColor", Hyprlang::INT{CHyprColor(0, 0, 0, 0).getAsHex()});
