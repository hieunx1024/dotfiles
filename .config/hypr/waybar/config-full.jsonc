{
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/submap", "group/grouptabs"],
  "modules-center": ["mpris", "clock", "custom/notification"],
  "modules-right": [
    "idle_inhibitor",
    "group/hardware",
    "group/media",
    "group/connections",
    "group/energy",
    "group/traybar",
    "custom/power"
  ],
  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"],
  },
  "group/media": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "custom/backlight"],
  },
  "group/connections": {
    "orientation": "horizontal",
    "modules": ["custom/vpn", "network", "bluetooth"],
  },
  "group/energy": {
    "orientation": "horizontal",
    "modules": ["custom/power-profile", "battery"],
  },
  "group/traybar": {
    "orientation": "horizontal",
    "modules": ["custom/spotify-tray", "tray"],
  },
  "hyprland/workspaces": {
    // Tắt handler cuộn nội bộ để Waybar chạy hai lệnh tùy chỉnh bên dưới.
    "disable-scroll": true,
    "warp-on-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "format": "{name}",
  },
  "hyprland/submap": {
    "format": " {}",
  },
  "group/grouptabs": {
    "orientation": "horizontal",
    "modules": [
      "custom/tab1",
      "custom/tab2",
      "custom/tab3",
      "custom/tab4",
      "custom/tab5"
    ],
    "on-scroll-up": "hyprctl dispatch changegroupactive b",
    "on-scroll-down": "hyprctl dispatch changegroupactive f"
  },
  "custom/tab1": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/hypr/scripts/group-tab.py 1",
    "on-click": "hyprctl dispatch changegroupactive 1",
    "on-scroll-up": "hyprctl dispatch changegroupactive b",
    "on-scroll-down": "hyprctl dispatch changegroupactive f",
    "tooltip": true
  },
  "custom/tab2": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/hypr/scripts/group-tab.py 2",
    "on-click": "hyprctl dispatch changegroupactive 2",
    "on-scroll-up": "hyprctl dispatch changegroupactive b",
    "on-scroll-down": "hyprctl dispatch changegroupactive f",
    "tooltip": true
  },
  "custom/tab3": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/hypr/scripts/group-tab.py 3",
    "on-click": "hyprctl dispatch changegroupactive 3",
    "on-scroll-up": "hyprctl dispatch changegroupactive b",
    "on-scroll-down": "hyprctl dispatch changegroupactive f",
    "tooltip": true
  },
  "custom/tab4": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/hypr/scripts/group-tab.py 4",
    "on-click": "hyprctl dispatch changegroupactive 4",
    "on-scroll-up": "hyprctl dispatch changegroupactive b",
    "on-scroll-down": "hyprctl dispatch changegroupactive f",
    "tooltip": true
  },
  "custom/tab5": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/hypr/scripts/group-tab.py 5",
    "on-click": "hyprctl dispatch changegroupactive 5",
    "on-scroll-up": "hyprctl dispatch changegroupactive b",
    "on-scroll-down": "hyprctl dispatch changegroupactive f",
    "tooltip": true
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "player-icons": {
      "default": "󰎆",
      "spotify": "",
      "firefox": "󰈹",
    },
    "status-icons": {
      "paused": "󰐊",
    },
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next",
    "max-length": 30,
    "tooltip": false,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛐",
      "deactivated": "󰛑",
    },
    "tooltip-format-activated": "Đang chống tắt màn hình (Màn hình luôn sáng)",
    "tooltip-format-deactivated": "Tự động tắt màn hình đang bật (Click để chống tắt màn)",
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-on": "",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format-connected": "{device_alias} ({device_battery_percentage}%)\nClick: blueman-manager",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "tray": {
    // Spotify đăng ký Passive nhưng không có Activate; dùng nút custom bên cạnh để click mở cửa sổ.
    "show-passive-items": false,
    "spacing": 10,
  },
  "custom/spotify-tray": {
    "exec-if": "pgrep -x spotify",
    "exec": "printf ''",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "Spotify — click để hiện cửa sổ",
    "on-click": "~/.config/hypr/scripts/spotify.sh --show",
  },
  "custom/vpn": {
    "exec-if": "~/.config/hypr/scripts/vpn-status.sh --check",
    "exec": "~/.config/hypr/scripts/vpn-status.sh",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "kitty --app-id floating_network -e ~/.config/hypr/scripts/nmtui-themed.sh",
  },
  "network": {
    "interface": "wl*",
    "interval": 5,
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "󰖩 {essid} ({signalStrength}%)\n󰩟 {ipaddr}\n󰁝 {bandwidthUpBytes}  󰁅 {bandwidthDownBytes}\nClick: Cài đặt mạng",
    "tooltip-format-ethernet": "󰈀 {ipaddr}\n󰁝 {bandwidthUpBytes}  󰁅 {bandwidthDownBytes}\nClick: Cài đặt mạng",
    "tooltip-format-disconnected": "Không có kết nối mạng",
    "on-click": "kitty --app-id floating_network -e ~/.config/hypr/scripts/nmtui-themed.sh",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰋋 {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "speaker": ["󰕿", "󰖀", "󰕾"],
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-scroll-up": "~/.config/hypr/scripts/volume_up.sh",
    "on-scroll-down": "~/.config/hypr/scripts/volume_down.sh",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "{desc}\n{volume}%",
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": false,
    "on-click": "kitty --app-id floating_btop -e btop",
  },
  "memory": {
    "interval": 2,
    "format": "󰘚 {used:0.1f}G",
    "tooltip-format": "Used: {used:0.1f}GiB\nAvailable: {avail:0.1f}GiB\nTotal: {total:0.1f}GiB",
    "on-click": "kitty --app-id floating_btop -e btop",
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 90,
    "format": "󰔏 {temperatureC}°C",
    "format-critical": "󰔓 {temperatureC}°C",
    "tooltip": false,
    "on-click": "kitty --app-id floating_btop -e btop",
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 20,
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-time": "{H} giờ {M} phút",
    "tooltip": true,
    "tooltip-format": "󰁹 Dung lượng: {capacity}%\nThời gian: {time}\n󱐋 Công suất: {power:.1f}W\n󰋑 Sức khỏe pin: {health}%",
    "tooltip-format-charging": "󰂄 Đang sạc: {capacity}%\n󱐋 Sạc đầy sau: {time}\n󰚥 Công suất sạc: {power:.1f}W\n󰋑 Sức khỏe pin: {health}%",
    "tooltip-format-discharging": "󰁹 Đang dùng pin: {capacity}%\n󱐋 Thời gian còn lại: {time}\n󰚥 Công suất xả: {power:.1f}W\n󰋑 Sức khỏe pin: {health}%",
    "tooltip-format-full": "󰁹 Pin đã sạc đầy (100%)\n󰚥 Đang cắm nguồn điện\n󰋑 Sức khỏe pin: {health}%",
    "tooltip-format-plugged": "󰂄 Đã cắm nguồn: {capacity}%\n󰋑 Sức khỏe pin: {health}%",
  },
  "custom/power-profile": {
    "exec": "~/.config/hypr/scripts/power-profile.sh --status",
    "interval": 10,
    "signal": 2,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/power-profile.sh --next",
    "on-click-right": "~/.config/hypr/scripts/power-profile.sh --menu",
    "on-scroll-up": "~/.config/hypr/scripts/power-profile.sh --prev",
    "on-scroll-down": "~/.config/hypr/scripts/power-profile.sh --next",
    "tooltip": true,
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },
  "custom/backlight": {
    "exec": "~/.config/hypr/scripts/brightness.sh",
    "interval": "once",
    "signal": 1,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/night-mode.sh",
    "on-click-right": "~/.config/hypr/scripts/night-mode.sh --menu",
    "on-scroll-up": "brightnessctl set +5% && pkill -RTMIN+1 waybar",
    "on-scroll-down": "brightnessctl set 5%- && pkill -RTMIN+1 waybar",
    "tooltip": true,
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/power": {
    "format": "",
    "on-click": "wlogout -l ~/.config/hypr/apps/wlogout/layout -C ~/.config/hypr/apps/wlogout/style.css -b 6 -c 20 -r 20 -L 100 -R 100 -T 320 -B 320",
    "tooltip": false,
  },
}
