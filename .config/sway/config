# Sway Configuration
# Theme: Modular (include theme.conf)

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu env PATH=$HOME/.local/bin:$PATH fuzzel
set $browser MOZ_ENABLE_WAYLAND=1 firefox
set $file nautilus

### Visuals
font pango:JetBrainsMono Nerd Font 10

gaps inner 5
gaps outer 5
smart_gaps on
smart_borders on

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
titlebar_border_thickness 0
titlebar_padding 8 1
title_align center

include ~/.config/sway/theme.conf

### Output Configuration
output * max_render_time 5
output eDP-1 mode 1920x1080 position 0 0 adaptive_sync off
output HDMI-A-1 mode 1920x1080@100Hz

# Clamshell Mode (Gập máy khi cắm màn ngoài)
bindswitch --reload --locked lid:on exec ~/.config/sway/scripts/clamshell.sh close
bindswitch --reload --locked lid:off exec ~/.config/sway/scripts/clamshell.sh open

### Input Configuration
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt disabled
    accel_profile flat
    pointer_accel 0.82
}

input "type:keyboard" {
    xkb_numlock enabled
}

### Autostart
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP _JAVA_AWT_WM_NONREPARENTING
# Sau khi import env: restart các service systemd/dbus còn giữ env của phiên trước
# (vừa ở Hyprland/KDE mà chưa reboot) -> portal timeout 25-120s, app GTK/swaync mở chậm cả phút.
# swaync chạy dưới systemd (swaync.service) để chỉ có đúng 1 bản, không tranh với dbus-activation.
# Xoá biến IBus GNOME để lại (GTK/QT_IM_MODULE=ibus, XMODIFIERS=@im=ibus): sway dùng fcitx5, app được
# dbus/systemd khởi động mà nhận biến cũ sẽ tìm IBus (đã tắt) -> không gõ được tiếng Việt.
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP _JAVA_AWT_WM_NONREPARENTING=1 && \
     dbus-update-activation-environment GTK_IM_MODULE= QT_IM_MODULE= XMODIFIERS= IBUS_ENABLE_SYNC_MODE= && \
     systemctl --user unset-environment GTK_IM_MODULE QT_IM_MODULE XMODIFIERS IBUS_ENABLE_SYNC_MODE && \
     systemctl --user restart --no-block xdg-desktop-portal-gtk xdg-desktop-portal-wlr xdg-desktop-portal swaync

exec wl-paste --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec ~/.config/sway/scripts/launch-polkit.sh
exec fcitx5 -rd
exec xhost +local:root

exec_always systemctl --user restart swaync
exec_always waypaper --restore
exec_always ~/.config/sway/scripts/statusbar.sh
# Canh phiên: khi phiên kết thúc gỡ SWAYSOCK khỏi env systemd/dbus + dừng portal/swaync (user service,
# logind không dọn) -> GNOME/Hyprland/sway kế tiếp bắt đầu sạch. Tiến trình của phiên do logind dọn
# (KillUserProcesses=yes). "exec" = 1 lần mỗi phiên.
exec ~/.config/sway/scripts/session-exit.sh
# Lúc đăng nhập: báo nếu còn tiến trình nền sót lại từ phiên trước (log ~/.local/state/session-check.log)
exec ~/.config/sway/scripts/session-check.sh
exec_always ~/.config/sway/scripts/auto-display.sh
exec_always ~/.config/sway/scripts/audio-autoswitch.py
exec_always ~/.config/sway/scripts/idle-manager.sh
# Giao diện riêng của phiên sway (theme GTK, icon, cursor, font) - không lẫn với KDE/GNOME
exec_always ~/.config/session-theme/session-theme.sh sway

### Window Rules & Workspace Assignments
focus_on_window_activation focus

### Window Title Format (Chỉ hiện tên app trên tab khi Super+M / Super+W / Super+S)
for_window [app_id=".*"] title_format "%app_id"
for_window [class=".*"] title_format "%class"
for_window [app_id="(?i)kitty"] title_format "Kitty"
for_window [app_id="(?i)firefox"] title_format "Firefox"
for_window [app_id="(?i)google-chrome"] title_format "Google Chrome"
for_window [app_id="(?i)brave-browser"] title_format "Brave"
for_window [app_id="(?i)code"] title_format "VS Code"
for_window [app_id="(?i)cursor"] title_format "Cursor"
for_window [app_id="(?i)vscodium"] title_format "VSCodium"
for_window [app_id="(?i)jetbrains-idea"] title_format "IntelliJ IDEA"
for_window [class="(?i)jetbrains"] title_format "IntelliJ IDEA"
for_window [app_id="(?i)jetbrains-datagrip"] title_format "DataGrip"
for_window [app_id="(?i)dbeaver"] title_format "DBeaver"
for_window [class="(?i)dbeaver"] title_format "DBeaver"
for_window [app_id="(?i)antigravity"] title_format "Antigravity"
for_window [app_id="(?i)(com\.anthropic\.claude|claude)"] title_format "Claude"
for_window [app_id="(?i)chatgpt"] title_format "ChatGPT"
for_window [app_id="(?i)obsidian"] title_format "Obsidian"
for_window [class="(?i)obsidian"] title_format "Obsidian"
for_window [app_id="(?i)(desktopeditors|onlyoffice)"] title_format "ONLYOFFICE"
for_window [app_id="(?i)(nautilus|org\.gnome\.nautilus)"] title_format "Files"
for_window [app_id="(?i)viber"] title_format "Viber"
for_window [class="(?i)viber.*"] title_format "Viber"
for_window [app_id="(?i)spotify"] title_format "Spotify"
for_window [class="(?i)spotify"] title_format "Spotify"
for_window [app_id="(?i)(discord|vesktop|webcord)"] title_format "Discord"
for_window [class="(?i)(discord|vesktop|webcord)"] title_format "Discord"
for_window [app_id="(?i)org\.telegram\.desktop"] title_format "Telegram"
for_window [app_id="(?i)postman"] title_format "Postman"

# WS1: Terminal
assign [app_id="kitty"] workspace number 1

# WS2: IDE (IntelliJ, VS Code, Cursor)
assign [app_id="(?i)(code|vscodium|cursor|jetbrains-idea)"] workspace number 2
assign [class="(?i)(code|vscodium|cursor|jetbrains)"] workspace number 2
for_window [class="(?i)jetbrains" window_type="dialog|menu"] floating enable
for_window [class="(?i)jetbrains" title="win0|splash|Welcome to .*"] floating enable
# Chỉ dialog "Edit ..." (vd Edit Configurations); ".*Edit.*" làm float cả cửa sổ IDE khi mở file tên có "Edit"
for_window [class="(?i)jetbrains" title="^Edit .*"] floating enable

# WS3: Browsers
assign [app_id="(?i)(firefox|google-chrome|brave-browser|tor browser)"] workspace number 3
assign [class="(?i)(firefox|google-chrome|brave-browser|tor browser)"] workspace number 3

# WS4: AI Agents & Chat
assign [app_id="(?i)(com\.anthropic\.claude|claude|chatgpt|antigravity|org\.telegram\.desktop)"] workspace number 4
assign [class="(?i)(claude|chatgpt|antigravity)"] workspace number 4
for_window [title="(?i)claude code"] move to workspace number 4

# WS5: Notes
assign [app_id="obsidian"] workspace number 5
assign [class="(?i)obsidian"] workspace number 5

# WS6: Database (DBeaver, DataGrip)
assign [app_id="(?i)(dbeaver|jetbrains-datagrip)"] workspace number 6
assign [class="(?i)(dbeaver|jetbrains-datagrip)"] workspace number 6
for_window [class="(?i)dbeaver" window_type="dialog"] floating enable

# Floating Helper Rules
for_window [app_id="view-launcher"] floating enable, border none, sticky enable, move position center
for_window [app_id="floating_shortcut"] floating enable, resize set 1000 700, move position center
for_window [app_id="floating_network"] floating enable, resize set 800 600, move position center
for_window [app_id="floating_btop"] floating enable, resize set 1150 750, move position center
for_window [app_id="at.yrlf.wl_mirror"] floating enable, border none, no_focus

# Gaming
for_window [app_id="gamescope"] floating disable
for_window [class="^steam_app_.*"] floating disable

# Scratchpad Rules & Toggles
for_window [app_id="(?i)(discord|vesktop|webcord)"] floating enable, resize set 1200 800, move position center, move scratchpad
for_window [class="(?i)(discord|vesktop|webcord)"] floating enable, resize set 1200 800, move position center, move scratchpad
for_window [app_id="(?i)spotify"] floating enable, resize set 1200 800, move position center, move scratchpad
for_window [class="(?i)spotify"] floating enable, resize set 1200 800, move position center, move scratchpad
for_window [app_id="(?i)viber"] floating enable, resize set 1200 800, move position center, move scratchpad
for_window [class="(?i)viber.*"] floating enable, resize set 1200 800, move position center, move scratchpad

bindsym $mod+Ctrl+d [class="(?i)discord"] scratchpad show
bindsym $mod+Ctrl+s [class="(?i)spotify"] scratchpad show
bindsym $mod+Ctrl+v [app_id="(?i)viber"] scratchpad show

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+Ctrl+minus move container to workspace current; floating disable

### Keybindings
# Applications
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+Shift+q exec ~/.config/sway/scripts/force-kill.sh
bindsym $mod+d exec $menu
bindsym Ctrl+Alt+space exec view-launcher
bindsym $mod+b exec $browser
bindsym $mod+e exec $file
bindsym $mod+v exec ~/.config/sway/scripts/clipboard.sh
bindsym $mod+i exec $term --app-id floating_shortcut -e nvim -R ~/.config/sway/shortcut.md
bindsym $mod+n exec swaync-client -t -sw
bindsym $mod+Tab exec ~/.config/sway/scripts/window-switcher.sh

# System Controls
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Ctrl+b exec pkill -USR1 waybar
bindsym $mod+Shift+b exec ~/.config/waybar/scripts/toggle-mode.sh
bindsym $mod+Shift+t exec ~/.config/sway/scripts/theme-selector.sh
bindsym $mod+Shift+u exec ~/.config/sway/scripts/theme-toggle.sh
bindsym $mod+Shift+e exec ~/.config/sway/scripts/powermenu.sh
bindsym $mod+Shift+p exec ~/.config/sway/scripts/display-mode.sh
bindsym $mod+Ctrl+l exec ~/.config/sway/scripts/lock.sh
bindsym $mod+Alt+s exec ~/.config/sway/scripts/suspend.sh

# Focus (hjkl & arrows)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move Containers (hjkl & arrows)
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Ctrl+Right workspace next
bindsym $mod+Ctrl+Left workspace prev
bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev

# Layout & Fullscreen
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+x layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+m layout toggle tabbed split; gaps inner current toggle 0; gaps outer current toggle 0
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# Hardware Fn Keys
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec ~/.config/sway/scripts/volume_down.sh
bindsym --locked XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume_up.sh
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%- && pkill -RTMIN+1 waybar
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+ && pkill -RTMIN+1 waybar
bindsym $mod+Shift+n exec ~/.config/sway/scripts/night-mode.sh
bindsym $mod+Ctrl+n exec ~/.config/sway/scripts/night-mode.sh --menu
bindsym $mod+Shift+a exec ~/.config/sway/scripts/toggle_audio.sh

# Screenshots
bindsym $mod+Shift+s exec bash -c 'GEOM=$(slurp) && [ -n "$GEOM" ] && grim -g "$GEOM" - | wl-copy'
bindsym Print exec grim - | swappy -f -

### Resize Mode
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

include /etc/sway/config.d/*
