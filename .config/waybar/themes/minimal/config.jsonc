{
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "spacing": 4,
  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
  "modules-center": ["mpris", "clock"],
  "modules-right": [
    "group/traybar",
    "group/system",
    "pulseaudio",
    "custom/backlight",
    "custom/vpn",
    "network",
    "bluetooth",
    "battery",
    "custom/power"
  ],
  "group/system": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"],
  },
  "group/traybar": {
    "orientation": "horizontal",
    "modules": ["idle_inhibitor", "tray"],
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "format": "{name}",
  },
  "sway/mode": {
    "format": " {}",
  },
  "sway/window": {
    "format": "{app_id}",
    "max-length": 40,
    "tooltip": false,
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "player-icons": {
      "default": "󰎆",
      "spotify": "",
      "firefox": "󰈹",
    },
    "status-icons": {
      "paused": "󰐊",
    },
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next",
    "max-length": 30,
    "tooltip": false,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉",
    },
    "tooltip-format-activated": "Đang chặn tự động khóa màn hình",
    "tooltip-format-deactivated": "Tự động khóa màn hình đang bật",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "tray": {
    "spacing": 10,
  },
  "custom/vpn": {
    "exec": "/home/hieunx/.config/waybar/scripts/vpn-status.sh",
    "exec-if": "ip link show tun0 up",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
  },
  "network": {
    "interface": "wl*",
    "interval": 10,
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} {signalStrength}%\n⬆ {bandwidthUpBytes}  ⬇ {bandwidthDownBytes}",
    "on-click": "kitty --app-id floating_network -e nmtui",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂱 {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "speaker": "󰕾",
      "default": "󰕾",
    },
    "on-scroll-up": "/home/hieunx/.config/sway/scripts/volume_up.sh",
    "on-scroll-down": "/home/hieunx/.config/sway/scripts/volume_down.sh",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "{desc}\n{volume}%",
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": false,
    "on-click": "kitty -e top",
  },
  "memory": {
    "interval": 2,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "Used: {used:0.1f}GiB\nAvailable: {avail:0.1f}GiB\nTotal: {total:0.1f}GiB",
    "on-click": "kitty -e top",
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
    "interval": 5,
    "critical-threshold": 90,
    "format": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C",
    "tooltip": false,
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 20,
    },
    "format": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰂄 {capacity}%",
    "tooltip-format": "{timeTo}",
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#fabd2f'><b><u>{}</u></b></span>"
      }
    }
  },
  "custom/backlight": {
    "exec": "/home/hieunx/.config/waybar/scripts/brightness.sh",
    "interval": "once",
    "signal": 1,
    "return-type": "json",
    "on-click": "/home/hieunx/.config/sway/scripts/night-mode.sh",
    "on-scroll-up": "brightnessctl set +5% && pkill -RTMIN+1 waybar",
    "on-scroll-down": "brightnessctl set 5%- && pkill -RTMIN+1 waybar",
    "tooltip": true,
  },
  "custom/power": {
    "format": "",
    "on-click": "/home/hieunx/.config/sway/scripts/powermenu.sh",
    "tooltip": false,
  },
}
