{
  "layer": "top",
  "position": "top",
  "height": 22,
  "margin-top": 2,
  "margin-left": 6,
  "margin-right": 6,
  "margin-bottom": 1,
  "spacing": 4,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["group/center"],
  "modules-right": ["group/status"],
  "group/center": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "custom/notification"
    ]
  },
  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "custom/vpn",
      "network",
      "bluetooth",
      "pulseaudio",
      "battery",
      "tray"
    ]
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "format": "{name}",
    "all-outputs": false
  },
  "sway/mode": {
    "format": "󰘳 {}",
    "tooltip": false
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },
  "custom/vpn": {
    "exec-if": "~/.config/waybar/scripts/vpn-status.sh --check",
    "exec": "~/.config/waybar/scripts/vpn-status.sh",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "kitty --app-id floating_network -e ~/.config/sway/scripts/nmtui-themed.sh"
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "󰖩 {essid} ({signalStrength}%)\n󰩟 {ipaddr}\n󰁝 {bandwidthUpBytes}  󰁅 {bandwidthDownBytes}\nClick: Cài đặt mạng",
    "tooltip-format-ethernet": "󰈀 {ipaddr}\n󰁝 {bandwidthUpBytes}  󰁅 {bandwidthDownBytes}\nClick: Cài đặt mạng",
    "tooltip-format-disconnected": "Không có kết nối mạng",
    "on-click": "kitty --app-id floating_network -e ~/.config/sway/scripts/nmtui-themed.sh"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-on": "",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format-connected": "󰂱 {device_alias} ({device_battery_percentage}%)\nClick: Quản lý Bluetooth",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰋋 {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "speaker": ["󰕿", "󰖀", "󰕾"],
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-scroll-up": "~/.config/sway/scripts/volume_up.sh",
    "on-scroll-down": "~/.config/sway/scripts/volume_down.sh",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "{desc}\n{volume}%"
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "tooltip": true,
    "tooltip-format": "Dung lượng: {capacity}%\nCông suất: {power:.1f}W\nThời gian: {time}"
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "tray": {
    "spacing": 8,
    "icon-size": 14
  }
}
